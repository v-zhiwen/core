      "problem": "Tampering vulnerability",
      "weakness": "CWE-59",
      "timeline": {
        "disclosure": {
          "date": "2026-06-09",
          "description": "Disclosed"
        },
        "fixed": {
          "date": "2026-06-09",
          "description": "System.Formats.Tar - TarEntry.cs:GetFullDestinationPath - Symlink path traversal enables arbitrary file write"
        }
      },
      "cna": {
        "name": "microsoft",
        "severity": "medium",
        "impact": "Security Feature Bypass",
        "acknowledgments": [
          "Anonymous, Ashmit Sharma, Ky0toFu, phrolo7a"
        ]
      },
      "description": [
        "Microsoft is releasing this security advisory to provide information about a vulnerability in System.Formats.Tar. This advisory also provides guidance on what developers can do to update their applications to remove this vulnerability.",
        "A tampering vulnerability exists in the \u0060TarEntry.GetFullDestinationPath\u0060 method where a symlink path traversal enables an attacker to perform arbitrary file writes outside the intended extraction directory."
      ],
      "platforms": [
        "windows"
      ],
      "architectures": [
